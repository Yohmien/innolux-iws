<configuration>
    <property name="log.root" value="${LOG_ROOT:-./logs}"/>
    <property name="log.path" value="${log.root}/iws-admin"/>
    <property name="log.maxFileSize" value="${LOG_MAX_FILE_SIZE:-50MB}"/>
    <property name="log.maxHistory" value="${LOG_MAX_HISTORY:-60}"/>
    <property name="console.log.pattern"
              value="%cyan(%d{yyyy-MM-dd HH:mm:ss}) %green([%thread]) %highlight(%-5level) %boldMagenta(%logger{36}%n) - %msg%n"/>
    <property name="log.pattern" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${console.log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <!-- 主服务全量汇总日志：所有 logger 与所有已启用级别 -->
    <appender name="file_all" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/all.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/all.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <!-- com.innolux.iws 下的日志按源码模块动态分文件，第三方与框架日志只进汇总 -->
    <appender name="file_module" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="com.innolux.iws.logging.IwsModuleDiscriminator"/>
        <sift>
            <appender name="module-${moduleName}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${log.path}/modules/${moduleName}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${log.path}/modules/${moduleName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                    <maxFileSize>${log.maxFileSize}</maxFileSize>
                    <maxHistory>${log.maxHistory}</maxHistory>
                </rollingPolicy>
                <encoder>
                    <pattern>${log.pattern}</pattern>
                    <charset>utf-8</charset>
                </encoder>
            </appender>
        </sift>
        <timeout>30 minutes</timeout>
        <maxAppenderCount>16</maxAppenderCount>
    </appender>

    <!-- 整合 skywalking 控制台输出 tid -->
<!--    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">-->
<!--        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">-->
<!--            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">-->
<!--                <pattern>[%tid] ${console.log.pattern}</pattern>-->
<!--            </layout>-->
<!--            <charset>utf-8</charset>-->
<!--        </encoder>-->
<!--    </appender>-->

    <!-- 整合 skywalking 推送采集日志 -->
<!--    <appender name="sky_log" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">-->
<!--        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">-->
<!--            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">-->
<!--                <pattern>[%tid] ${console.log.pattern}</pattern>-->
<!--            </layout>-->
<!--            <charset>utf-8</charset>-->
<!--        </encoder>-->
<!--    </appender>-->

    <!-- com.innolux.iws 模块日志；additivity 保留向根汇总日志的传递 -->
    <logger name="com.innolux.iws" additivity="true">
        <appender-ref ref="file_module"/>
    </logger>

    <!-- 完整 SQL 日志使用独立 topic，明确归入 common 模块 -->
    <logger name="SQL_FULL" additivity="true">
        <appender-ref ref="file_module"/>
    </logger>

    <!--系统操作日志-->
    <root level="info">
        <appender-ref ref="console" />
        <appender-ref ref="file_all" />
<!--        <appender-ref ref="sky_log"/>-->
    </root>

</configuration>
